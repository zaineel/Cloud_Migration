# ===========================================
# MavPrep Environment Variables (Example)
# ===========================================
# Copy this file to .env.local for local development
# Add these same variables to AWS Amplify Console for production
# DO NOT commit .env.local to version control!
# ===========================================

# ============ AWS Cognito (Client-side) ============
# These are exposed to the browser (NEXT_PUBLIC_ prefix)
# Get these from AWS Cognito Console > User Pool > App Integration

NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_AWS_REGION=us-east-2

# ============ AWS DynamoDB (Server-side) ============
# These are only available on the server (API routes)
# Create an IAM user with DynamoDB access and get credentials

MAVPREP_AWS_REGION=us-east-2
MAVPREP_AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
MAVPREP_AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DYNAMODB_TABLE_NAME=MavPrepData

# ============ AWS S3 (Exam Papers) ============
# S3 bucket for storing exam paper PDFs
S3_EXAM_PAPERS_BUCKET=mavprep-exam-papers-prod

# ============ Application ============
# Production URL - UPDATE THIS after Amplify deployment
# Format: https://main.xxxxxxxxxxxxxx.amplifyapp.com

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============ Socket.IO (Production) ============
# WebRTC signaling server URL
# For production, you'll need a separate server for Socket.IO
# See DEPLOYMENT.md for setup instructions

NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
